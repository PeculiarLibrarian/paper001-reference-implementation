@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix padi: <http://padi.s.m.gitandu.bs/core#> .

padi:CoreConceptScheme
    a skos:ConceptScheme ;
    skos:prefLabel "PADI Core Concept Scheme" .

padi:FinanceConcept
    a skos:Concept ;
    skos:inScheme padi:CoreConceptScheme ;
    skos:prefLabel "Finance Concept" .

padi:RevenueConcept
    a skos:Concept ;
    skos:inScheme padi:CoreConceptScheme ;
    skos:prefLabel "Revenue Concept" ;
    skos:broader padi:FinanceConcept .

padi:EBITDAConcept
    a skos:Concept ;
    skos:inScheme padi:CoreConceptScheme ;
    skos:prefLabel "EBITDA Concept" ;
    skos:broader padi:FinanceConcept .

padi:GovernanceConcept
    a skos:Concept ;
    skos:inScheme padi:CoreConceptScheme ;
    skos:prefLabel "Governance Concept" .

padi:StateConcept
    a skos:Concept ;
    skos:inScheme padi:CoreConceptScheme ;
    skos:prefLabel "State Semantics" .
