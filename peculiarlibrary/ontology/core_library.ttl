@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix padi: <http://padi.s.m.gitandu.bs/core#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

padi: a owl:Ontology ;
    rdfs:label "PADI Core Constitution" ;
    rdfs:comment "Kernel ontology with SKOS-aligned reasoning layer." ;
    owl:versionInfo "0.2.4" ;
    owl:imports <http://www.w3.org/2004/02/skos/core> .

# --- Core Ontological Root ---
padi:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "Root semantic object for all domains." .

padi:State a owl:Class ;
    rdfs:subClassOf padi:Entity ;
    rdfs:label "State" ;
    rdfs:comment "Temporal snapshot of an entity." .

padi:Event a owl:Class ;
    rdfs:subClassOf padi:Entity ;
    rdfs:label "Event" ;
    rdfs:comment "Atomic transition between states." .

padi:Observation a owl:Class ;
    rdfs:subClassOf padi:Entity ;
    rdfs:label "Observation" ;
    rdfs:comment "Measured fact in a reporting context." .

# --- SKOS Integration Layer (FIXED ARCHITECTURE) ---

skos:Concept a owl:Class ;
    rdfs:subClassOf padi:Entity ;
    rdfs:label "Concept" ;
    rdfs:comment "Taxonomy node for semantic reasoning expansion." .

skos:ConceptScheme a owl:Class ;
    rdfs:subClassOf padi:Entity ;
    rdfs:label "Concept Scheme" .

# Proper bridging (CORRECT DIRECTION)
padi:conceptOf a owl:ObjectProperty ;
    rdfs:domain skos:Concept ;
    rdfs:range padi:Entity ;
    rdfs:label "concept of entity" .

padi:hasConcept a owl:ObjectProperty ;
    rdfs:domain padi:Entity ;
    rdfs:range skos:Concept ;
    rdfs:label "has concept" .

# Reasoning-safe SKOS alignment (NO misuse of subPropertyOf)
padi:broaderConcept a owl:ObjectProperty ;
    rdfs:subPropertyOf skos:broader ;
    rdfs:label "broader concept link" .

padi:narrowerConcept a owl:ObjectProperty ;
    rdfs:subPropertyOf skos:narrower ;
    rdfs:label "narrower concept link" .
