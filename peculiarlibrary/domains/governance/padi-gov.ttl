# v0.4.0 Governance Domain (padi-gov:)
@prefix padi: <http://padi.s.m.gitandu.bs/core#> .
@prefix padi-gov: <http://padi.s.m.gitandu.bs/gov#> .
@prefix padi-org: <http://padi.s.m.gitandu.bs/org#> .
@prefix padi-align: <http://padi.s.m.gitandu.bs/align#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://padi.s.m.gitandu.bs/gov>
    a owl:Ontology ;
    owl:imports 
        <http://padi.s.m.gitandu.bs/core>,
        <http://padi.s.m.gitandu.bs/align> ;
    rdfs:label "PADI Governance Domain Library" ;
    owl:versionInfo "0.4.0" .

padi-gov:GovernanceBody a owl:Class ;
    rdfs:subClassOf padi:Entity ;
    rdfs:label "Governance Body" .

padi-gov:Board a owl:Class ;
    rdfs:subClassOf padi-gov:GovernanceBody .

padi-gov:Committee a owl:Class ;
    rdfs:subClassOf padi-gov:GovernanceBody .

padi-gov:DirectorRole a skos:Concept ;
    skos:prefLabel "Director Role" .

padi-gov:ExecutiveRole a skos:Concept ;
    skos:prefLabel "Executive Role" .
