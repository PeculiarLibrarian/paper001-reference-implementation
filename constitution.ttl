@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix padi: <http://padi.s.m.gitandu.bs/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

padi: a owl:Ontology ;
    rdfs:label "PADI Core Constitution" ;
    rdfs:comment "Constitutional ontology defining the invariant semantic contracts shared by every Peculiar Library domain." ;
    owl:versionInfo "0.2.2" .

padi:OrganizationShape a sh:NodeShape ;
    sh:property [ sh:class padi:LegalStatus ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path padi:hasLegalStatus ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path skos:prefLabel ],
        [ sh:class padi:ReportingPeriod ;
            sh:minCount 1 ;
            sh:path padi:hasReportingPeriod ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path padi:identifier ],
        [ sh:class padi:Jurisdiction ;
            sh:minCount 1 ;
            sh:path padi:hasJurisdiction ] ;
    sh:targetClass padi:Organization .

padi:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A sovereign geopolitical entity." ;
    rdfs:subClassOf padi:Entity .

padi:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A natural human being." ;
    rdfs:subClassOf padi:Entity .

padi:hasJurisdiction a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Jurisdiction" ;
    rdfs:comment "Associates an organisation with its jurisdiction." ;
    rdfs:domain padi:Organization ;
    rdfs:range padi:Jurisdiction .

padi:hasLegalStatus a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Legal status" ;
    rdfs:comment "Associates an organisation with its legal status." ;
    rdfs:domain padi:Organization ;
    rdfs:range padi:LegalStatus .

padi:hasReportingPeriod a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "Reporting period" ;
    rdfs:comment "Associates an organisation with a reporting period." ;
    rdfs:domain padi:Organization ;
    rdfs:range padi:ReportingPeriod .

padi:identifier a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Identifier" ;
    rdfs:comment "Canonical immutable identifier." ;
    rdfs:domain padi:Entity ;
    rdfs:range xsd:string .

padi:Jurisdiction a owl:Class ;
    rdfs:label "Jurisdiction" ;
    rdfs:comment "A territorial or legal boundary of authority." ;
    rdfs:subClassOf padi:Entity .

padi:LegalStatus a owl:Class ;
    rdfs:label "Legal Status" ;
    rdfs:comment "The legal classification of an organisation." ;
    rdfs:subClassOf padi:Entity .

padi:ReportingPeriod a owl:Class ;
    rdfs:label "Reporting Period" ;
    rdfs:comment "A bounded reporting interval." ;
    rdfs:subClassOf padi:Entity .

padi:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A legally or administratively recognised institutional entity." ;
    rdfs:subClassOf padi:Entity ;
    owl:disjointWith padi:Country,
        padi:Person .

padi:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "Root class for every semantic object." .


