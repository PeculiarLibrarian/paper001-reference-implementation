@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix core: <https://peculiarlibrary.org/ontology/core#> .
@prefix fin: <https://peculiarlibrary.org/ontology/finance#> .

<https://peculiarlibrary.org/ontology/finance>
    a owl:Ontology ;
    owl:versionInfo "1.1.2" ;
    owl:imports <https://peculiarlibrary.org/ontology/core> .

fin:FinancialObservation a owl:Class ;
    rdfs:subClassOf core:Observation .

fin:RevenueObservation a owl:Class ;
    rdfs:subClassOf fin:FinancialObservation .

fin:ProfitObservation a owl:Class ;
    rdfs:subClassOf fin:FinancialObservation .

fin:MonetaryResult a owl:Class ;
    rdfs:subClassOf core:NumericResult .

fin:amount a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

fin:currency a owl:ObjectProperty .

fin:observedEntity a owl:ObjectProperty ;
    rdfs:domain fin:FinancialObservation .

fin:hasReportingBasis a owl:ObjectProperty .
