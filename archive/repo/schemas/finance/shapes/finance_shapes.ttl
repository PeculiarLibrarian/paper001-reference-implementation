@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <https://peculiarlibrary.org/ontology/core#> .
@prefix fin: <https://peculiarlibrary.org/ontology/finance#> .

fin:FinancialObservationShape a sh:NodeShape ;
    sh:targetClass fin:FinancialObservation ;

    sh:property [
        sh:path fin:observedEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path core:hasResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path core:validFrom ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
    ] ;

    sh:property [
        sh:path core:validTo ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
    ] .
