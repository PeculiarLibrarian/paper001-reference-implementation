@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix fin: <http://padi.s.m.gitandu.bs/finance#> .
@prefix gov: <http://padi.s.m.gitandu.bs/governance#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# --------------------------------------
# EBITDA must be a valid numeric value
# --------------------------------------
fin:EBITDAShape
    a sh:NodeShape ;
    sh:targetClass fin:EBITDA ;
    sh:property [
        sh:path fin:EBITDA ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
    ] .

# --------------------------------------
# Revenue must be positive
# --------------------------------------
fin:RevenueShape
    a sh:NodeShape ;
    sh:targetClass fin:ServiceRevenue ;
    sh:property [
        sh:path fin:ServiceRevenue ;
        sh:minInclusive 0 ;
    ] .

# --------------------------------------
# Board approval must be a valid date
# --------------------------------------
gov:BoardApprovalShape
    a sh:NodeShape ;
    sh:targetClass gov:BoardApprovalDate ;
    sh:property [
        sh:path gov:BoardApprovalDate ;
        sh:datatype xsd:date ;
    ] .

# --------------------------------------
# Financial consistency rule (simple sanity check)
# --------------------------------------
fin:MarginConsistencyShape
    a sh:NodeShape ;
    sh:message "EBITDA should not exceed Service Revenue by unrealistic margin" ;
    sh:severity sh:Warning .
