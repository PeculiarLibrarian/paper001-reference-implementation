@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix padi: <http://padi.s.m.gitandu.bs/core#> .

#################################################################
# Ontology
#################################################################

padi:
    a owl:Ontology ;
    rdfs:label "PADI Core Ontology" ;
    rdfs:comment "Core semantic ontology for canonical fact compilation." ;
    owl:versionInfo "2.0.0" .

#################################################################
# Core Classes
#################################################################

padi:Entity
    a owl:Class ;
    rdfs:label "Entity" .

padi:CanonicalFact
    a owl:Class ;
    rdfs:label "Canonical Fact" ;
    rdfs:comment "Atomic semantic observation derived from authoritative evidence." .

padi:SourceRecord
    a owl:Class ;
    rdfs:label "Source Record" .

#################################################################
# Object Properties
#################################################################

padi:aboutEntity
    a owl:ObjectProperty ;
    rdfs:domain padi:CanonicalFact ;
    rdfs:range padi:Entity ;
    rdfs:label "about entity" .

padi:hasSource
    a owl:ObjectProperty ;
    rdfs:domain padi:CanonicalFact ;
    rdfs:range padi:SourceRecord ;
    rdfs:label "has source" .

#################################################################
# Canonical Fact Properties
#################################################################

padi:metric
    a owl:DatatypeProperty ;
    rdfs:domain padi:CanonicalFact ;
    rdfs:range xsd:string ;
    rdfs:label "metric" .

padi:value
    a owl:DatatypeProperty ;
    rdfs:domain padi:CanonicalFact ;
    rdfs:range rdfs:Literal ;
    rdfs:label "value" .

padi:unit
    a owl:DatatypeProperty ;
    rdfs:domain padi:CanonicalFact ;
    rdfs:range xsd:string ;
    rdfs:label "measurement unit" .

padi:period
    a owl:DatatypeProperty ;
    rdfs:domain padi:CanonicalFact ;
    rdfs:range xsd:string ;
    rdfs:label "reporting period" .

padi:confidence
    a owl:DatatypeProperty ;
    rdfs:domain padi:CanonicalFact ;
    rdfs:range xsd:decimal ;
    rdfs:label "confidence" .

#################################################################
# Source Metadata
#################################################################

padi:document
    a owl:DatatypeProperty ;
    rdfs:domain padi:SourceRecord ;
    rdfs:range xsd:string ;
    rdfs:label "document" .

padi:page
    a owl:DatatypeProperty ;
    rdfs:domain padi:SourceRecord ;
    rdfs:range xsd:integer ;
    rdfs:label "page" .

padi:section
    a owl:DatatypeProperty ;
    rdfs:domain padi:SourceRecord ;
    rdfs:range xsd:string ;
    rdfs:label "section" .

padi:context
    a owl:DatatypeProperty ;
    rdfs:domain padi:SourceRecord ;
    rdfs:range xsd:string ;
    rdfs:label "context" .

#################################################################
# Canonical Metric Vocabulary
#################################################################

padi:serviceRevenue
    a rdf:Property ;
    rdfs:label "Service Revenue" .

padi:ebitda
    a rdf:Property ;
    rdfs:label "EBITDA" .

padi:boardApprovalDate
    a rdf:Property ;
    rdfs:label "Board Approval Date" .

padi:monetaryGainIAS29
    a rdf:Property ;
    rdfs:label "Monetary Gain IAS 29" .

padi:mpesaRevenue
    a rdf:Property ;
    rdfs:label "M-PESA Revenue" .

padi:mpesaCapacityTPS
    a rdf:Property ;
    rdfs:label "M-PESA Capacity TPS" .
