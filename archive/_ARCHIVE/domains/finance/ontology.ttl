@prefix padi: <http://padi.s.m.gitandu.bs/core#> .
@prefix padi-fin: <http://padi.s.m.gitandu.bs/finance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://padi.s.m.gitandu.bs/finance>
    a owl:Ontology ;
    rdfs:label "PADI Finance Domain Library" ;
    owl:versionInfo "0.5.0" .

# -------------------------
# Core Financial Classes
# -------------------------

padi-fin:FinancialStatement
    a owl:Class ;
    rdfs:subClassOf padi:Entity ;
    rdfs:label "Financial Statement" .

padi-fin:RevenueMetric
    a owl:Class ;
    rdfs:subClassOf padi:Entity ;
    rdfs:label "Revenue Metric" .

padi-fin:ProfitabilityMetric
    a owl:Class ;
    rdfs:subClassOf padi:Entity ;
    rdfs:label "Profitability Metric" .

padi-fin:OperationalMetric
    a owl:Class ;
    rdfs:subClassOf padi:Entity ;
    rdfs:label "Operational Metric" .

padi-fin:FinancialAdjustment
    a owl:Class ;
    rdfs:subClassOf padi:Entity ;
    rdfs:label "Financial Adjustment" .

# -------------------------
# Property Declarations
# -------------------------

padi-fin:service_revenue
    a owl:DatatypeProperty ;
    rdfs:domain padi-fin:RevenueMetric ;
    rdfs:range xsd:decimal ;
    rdfs:label "Service Revenue" ;
    rdfs:comment "Revenue generated from telecom services." .

padi-fin:mpesa_revenue
    a owl:DatatypeProperty ;
    rdfs:domain padi-fin:RevenueMetric ;
    rdfs:range xsd:decimal ;
    rdfs:label "M-PESA Revenue" ;
    rdfs:comment "Revenue generated from M-PESA services." .

padi-fin:ebitda
    a owl:DatatypeProperty ;
    rdfs:domain padi-fin:ProfitabilityMetric ;
    rdfs:range xsd:decimal ;
    rdfs:label "EBITDA" ;
    rdfs:comment "Earnings before interest, tax, depreciation and amortisation." .

padi-fin:monetary_gain_ias29
    a owl:DatatypeProperty ;
    rdfs:domain padi-fin:FinancialAdjustment ;
    rdfs:range xsd:decimal ;
    rdfs:label "IAS 29 Monetary Gain" ;
    rdfs:comment "Monetary adjustment under IAS 29 inflation accounting." .

padi-fin:mpesa_capacity_tps
    a owl:DatatypeProperty ;
    rdfs:domain padi-fin:OperationalMetric ;
    rdfs:range xsd:integer ;
    rdfs:label "M-PESA TPS Capacity" ;
    rdfs:comment "Transaction throughput capacity per second." .

padi-fin:board_approval_date
    a owl:DatatypeProperty ;
    rdfs:domain padi-fin:FinancialStatement ;
    rdfs:range xsd:date ;
    rdfs:label "Board Approval Date" ;
    rdfs:comment "Date financial statements were approved by the board." .

