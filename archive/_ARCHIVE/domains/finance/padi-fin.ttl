@prefix padi: <http://padi.s.m.gitandu.bs/core#> .
@prefix padi-fin: <http://padi.s.m.gitandu.bs/fin#> .
@prefix padi-org: <http://padi.s.m.gitandu.bs/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://padi.s.m.gitandu.bs/fin>
    a owl:Ontology ;
    owl:imports
        <http://padi.s.m.gitandu.bs/core>,
        <http://padi.s.m.gitandu.bs/align> ;
    rdfs:label "PADI Finance Domain Library" ;
    owl:versionInfo "0.5.0" .

# ----------------------------------------------------
# FINANCE CORE STRUCTURES (STATE-BASED MODEL)
# ----------------------------------------------------

padi-fin:FinancialStatement a owl:Class ;
    rdfs:subClassOf padi:State ;
    rdfs:label "Financial Statement" ;
    rdfs:comment "Temporal financial snapshot of an entity." .

padi-fin:BalanceSheet a owl:Class ;
    rdfs:subClassOf padi-fin:FinancialStatement .

padi-fin:IncomeStatement a owl:Class ;
    rdfs:subClassOf padi-fin:FinancialStatement .

padi-fin:CashFlowStatement a owl:Class ;
    rdfs:subClassOf padi-fin:FinancialStatement .

# ----------------------------------------------------
# TEMPORAL ALIGNMENT
# ----------------------------------------------------

padi-fin:hasReportingPeriod a owl:ObjectProperty ;
    rdfs:domain padi-fin:FinancialStatement ;
    rdfs:range padi:ReportingPeriod .

padi-fin:reportedFor a owl:ObjectProperty ;
    rdfs:domain padi-fin:FinancialStatement ;
    rdfs:range padi-org:Organization .

# ----------------------------------------------------
# OBSERVATIONS (NEW KERNEL COMPATIBILITY)
# ----------------------------------------------------

padi-fin:FinancialObservation a owl:Class ;
    rdfs:subClassOf padi:Observation ;
    rdfs:label "Financial Observation" .

padi-fin:hasStatement a owl:ObjectProperty ;
    rdfs:domain padi-fin:FinancialObservation ;
    rdfs:range padi-fin:FinancialStatement .
