    <owl:versionIRI rdf:resource="https://peculiarlibrary.org/ontology/v3.0.0/organization.owl"/>
    <owl:versionInfo>3.0.0</owl:versionInfo>
    <skos:definition>The definitive actor model for the Safaricom Knowledge Graph, strictly separating timeless entities from versioned states, investment linkages, and restructuring events.</skos:definition>
