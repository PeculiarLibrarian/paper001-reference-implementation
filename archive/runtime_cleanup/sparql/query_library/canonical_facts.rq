PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX padi: <http://padi.s.m.gitandu.bs/core#>

SELECT
    ?entity
    ?metric
    ?value
    ?unit
    ?period
    ?confidence
    ?document
    ?page
    ?section
WHERE {

    ?fact
        rdf:type            padi:CanonicalFact ;
        padi:aboutEntity    ?entity ;
        padi:metric         ?metric ;
        padi:value          ?value ;
        padi:period         ?period ;
        padi:confidence     ?confidence ;
        padi:hasSource      ?source .

    OPTIONAL { ?fact   padi:unit      ?unit . }
    OPTIONAL { ?source padi:document  ?document . }
    OPTIONAL { ?source padi:page      ?page . }
    OPTIONAL { ?source padi:section   ?section . }

}
ORDER BY ?entity ?period ?metric
