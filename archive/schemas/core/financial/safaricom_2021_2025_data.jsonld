#!/data/data/com.termux/files/usr/bin/bash

set -e

INPUT="$1"

if [ -z "$INPUT" ]; then
  echo "Usage: ./run_ingest.sh path/to/file.jsonld"
  exit 1
fi

if [ ! -f "$INPUT" ]; then
  echo "ERROR: File not found -> $INPUT"
  exit 1
fi

echo "🔷 VALIDATING JSON-LD..."
./apache-jena-6.1.0/bin/riot --validate "$INPUT"

echo "🔷 COMPILING RDF..."
mkdir -p runtime

OUT="runtime/safaricom.ttl"

./apache-jena-6.1.0/bin/riot \
  --output=Turtle \
  "$INPUT" > "$OUT"

echo "✔ DONE: $OUT"
