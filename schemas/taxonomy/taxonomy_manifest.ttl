@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .

@prefix pltax: <https://peculiarlibrarian.org/taxonomy/> .

#################################################################
# TAXONOMY MANIFEST
#################################################################

pltax:TaxonomyManifest
    a owl:NamedIndividual ;
    dct:title "Peculiar Librarian Taxonomy Manifest" ;
    dct:description "Assembly manifest for all concept schemes participating in the Peculiar Librarian career taxonomy." ;
    skos:prefLabel "Taxonomy Manifest" ;

    pltax:includesScheme
        pltax:CompetencyScheme ,
        pltax:RoleScheme ,
        pltax:TechnologyScheme ,
        pltax:DomainScheme ,
        pltax:ArtifactScheme ,
        pltax:EvidenceScheme ,
        pltax:AchievementScheme .

#################################################################
# COMPETENCY SCHEME
#################################################################

pltax:CompetencyScheme
    a skos:ConceptScheme ;
    skos:prefLabel "Competencies" ;
    skos:definition "Professional capabilities, knowledge domains, and operational abilities." .

#################################################################
# ROLE SCHEME
#################################################################

pltax:RoleScheme
    a skos:ConceptScheme ;
    skos:prefLabel "Professional Roles" ;
    skos:definition "Career roles aligned to competencies and market opportunities." .

#################################################################
# TECHNOLOGY SCHEME
#################################################################

pltax:TechnologyScheme
    a skos:ConceptScheme ;
    skos:prefLabel "Technologies" ;
    skos:definition "Standards, frameworks, languages, platforms, and tools supporting competency execution." .

#################################################################
# DOMAIN SCHEME
#################################################################

pltax:DomainScheme
    a skos:ConceptScheme ;
    skos:prefLabel "Domains" ;
    skos:definition "Industry, research, and application domains where competencies are exercised." .

#################################################################
# ARTIFACT SCHEME
#################################################################

pltax:ArtifactScheme
    a skos:ConceptScheme ;
    skos:prefLabel "Artifacts" ;
    skos:definition "Concrete outputs produced through professional work." .

#################################################################
# EVIDENCE SCHEME
#################################################################

pltax:EvidenceScheme
    a skos:ConceptScheme ;
    skos:prefLabel "Evidence Types" ;
    skos:definition "Evidence used to substantiate competencies, achievements, and professional claims." .

#################################################################
# ACHIEVEMENT SCHEME
#################################################################

pltax:AchievementScheme
    a skos:ConceptScheme ;
    skos:prefLabel "Achievements" ;
    skos:definition "Notable professional outcomes demonstrating competency execution." .

#################################################################
# TOP-LEVEL SCHEME REGISTRY
#################################################################

pltax:CompetencyScheme
    skos:inScheme pltax:CareerTaxonomy .

pltax:RoleScheme
    skos:inScheme pltax:CareerTaxonomy .

pltax:TechnologyScheme
    skos:inScheme pltax:CareerTaxonomy .

pltax:DomainScheme
    skos:inScheme pltax:CareerTaxonomy .

pltax:ArtifactScheme
    skos:inScheme pltax:CareerTaxonomy .

pltax:EvidenceScheme
    skos:inScheme pltax:CareerTaxonomy .

pltax:AchievementScheme
    skos:inScheme pltax:CareerTaxonomy .

