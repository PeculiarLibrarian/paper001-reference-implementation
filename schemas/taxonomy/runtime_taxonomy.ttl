@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@prefix plrt: <https://peculiarlibrarian.org/runtime/> .

#################################################################
# RUNTIME TAXONOMY
#################################################################

plrt:RuntimeTaxonomy
    a skos:ConceptScheme ;
    skos:prefLabel "Runtime Taxonomy" ;
    skos:definition "Controlled vocabulary describing execution semantics." .

#################################################################
# PIPELINES
#################################################################

plrt:Pipeline
    a skos:Concept ;
    skos:inScheme plrt:RuntimeTaxonomy ;
    skos:prefLabel "Pipeline" .

plrt:VerificationPipeline
    a skos:Concept ;
    skos:broader plrt:Pipeline ;
    skos:prefLabel "Verification Pipeline" .

#################################################################
# STAGES
#################################################################

plrt:Stage
    a skos:Concept ;
    skos:inScheme plrt:RuntimeTaxonomy ;
    skos:prefLabel "Stage" .

plrt:ArtifactDiscovery
    a skos:Concept ;
    skos:broader plrt:Stage ;
    skos:prefLabel "Artifact Discovery" .

plrt:ArtifactProvenance
    a skos:Concept ;
    skos:broader plrt:Stage ;
    skos:prefLabel "Artifact Provenance" .

plrt:ArtifactRelationship
    a skos:Concept ;
    skos:broader plrt:Stage ;
    skos:prefLabel "Artifact Relationship" .

plrt:RelationshipIntegrity
    a skos:Concept ;
    skos:broader plrt:Stage ;
    skos:prefLabel "Relationship Integrity" .

plrt:RuntimeVerification
    a skos:Concept ;
    skos:broader plrt:Stage ;
    skos:prefLabel "Runtime Verification" .

#################################################################
# ARTIFACTS
#################################################################

plrt:Artifact
    a skos:Concept ;
    skos:inScheme plrt:RuntimeTaxonomy ;
    skos:prefLabel "Artifact" .

plrt:ArtifactInventory
    a skos:Concept ;
    skos:broader plrt:Artifact ;
    skos:prefLabel "Artifact Inventory" .

plrt:ArtifactRecord
    a skos:Concept ;
    skos:broader plrt:Artifact ;
    skos:prefLabel "Artifact Record" .

plrt:RelationshipGraph
    a skos:Concept ;
    skos:broader plrt:Artifact ;
    skos:prefLabel "Relationship Graph" .

plrt:RuntimeReport
    a skos:Concept ;
    skos:broader plrt:Artifact ;
    skos:prefLabel "Runtime Report" .

