@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

@prefix pl:    <https://peculiarlibrarian.org/ontology/> .
@prefix pltax: <https://peculiarlibrarian.org/taxonomy/> .

#################################################################
# COMPETENCY SHAPE
#################################################################

pl:CompetencyShape
    a sh:NodeShape ;
    sh:targetClass pl:Competency ;

    sh:property [
        sh:path pl:referencesTaxonomyConcept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every competency must reference exactly one taxonomy concept." ;
    ] .

#################################################################
# PERSON SHAPE
#################################################################

pl:PersonShape
    a sh:NodeShape ;
    sh:targetClass pl:Person ;

    sh:property [
        sh:path pl:hasCompetency ;
        sh:minCount 1 ;
        sh:class pl:Competency ;
        sh:message "Every person must possess at least one competency." ;
    ] .

#################################################################
# OPPORTUNITY SHAPE
#################################################################

pl:OpportunityShape
    a sh:NodeShape ;
    sh:targetClass pl:Opportunity ;

    sh:property [
        sh:path pl:requiresCompetency ;
        sh:minCount 1 ;
        sh:class pl:Competency ;
        sh:message "Every opportunity must require at least one competency." ;
    ] .

#################################################################
# APPLICATION SHAPE
#################################################################

pl:ApplicationShape
    a sh:NodeShape ;
    sh:targetClass pl:Application ;

    sh:property [
        sh:path pl:targetsOpportunity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class pl:Opportunity ;
        sh:message "Every application must target exactly one opportunity." ;
    ] ;

    sh:property [
        sh:path pl:submittedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class pl:Person ;
        sh:message "Every application must have exactly one applicant." ;
    ] .

#################################################################
# EVIDENCE SHAPE
#################################################################

pl:EvidenceShape
    a sh:NodeShape ;
    sh:targetClass pl:Evidence ;

    sh:property [
        sh:path pl:supportsCompetency ;
        sh:minCount 1 ;
        sh:class pl:Competency ;
        sh:message "Evidence must support at least one competency." ;
    ] .

#################################################################
# AGENT SHAPE
#################################################################

pl:AgentShape
    a sh:NodeShape ;
    sh:targetClass pl:Agent .
