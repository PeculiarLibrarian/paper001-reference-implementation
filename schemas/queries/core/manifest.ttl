@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pl:   <https://peculiarlibrarian.org/ontology/> .

pl:CompetencyCoverageQuery
    a pl:Query ;
    rdfs:label "Competency Coverage" ;
    pl:file "competency_coverage.sparql" .

pl:CompetencyInventoryQuery
    a pl:Query ;
    rdfs:label "Competency Inventory" ;
    pl:file "competency_inventory.sparql" .

pl:CompetencyTaxonomyMappingQuery
    a pl:Query ;
    rdfs:label "Competency Taxonomy Mapping" ;
    pl:file "competency_taxonomy_mapping.sparql" .

pl:OpportunityMatchingQuery
    a pl:Query ;
    rdfs:label "Opportunity Matching" ;
    pl:file "opportunity_matching.sparql" .
