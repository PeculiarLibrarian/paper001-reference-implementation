@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix pl: <https://peculiarlibrarian.org/ontology/> .

###############################################################
# VERIFICATION PIPELINE
###############################################################

pl:VerificationPipeline
    a pl:Pipeline ;
    pl:hasStage pl:ArtifactDiscovery ;
    pl:hasStage pl:ArtifactProvenance ;
    pl:hasStage pl:ArtifactRelationship ;
    pl:hasStage pl:RelationshipIntegrity ;
    pl:hasStage pl:RuntimeVerification .

###############################################################
# STAGES
###############################################################

pl:ArtifactDiscovery
    a pl:Stage ;
    pl:producesArtifact pl:ArtifactInventory .

pl:ArtifactProvenance
    a pl:Stage ;
    pl:consumesArtifact pl:ArtifactInventory ;
    pl:producesArtifact pl:ArtifactRecords .

pl:ArtifactRelationship
    a pl:Stage ;
    pl:consumesArtifact pl:ArtifactRecords ;
    pl:producesArtifact pl:RelationshipGraph .

pl:RelationshipIntegrity
    a pl:Stage ;
    pl:consumesArtifact pl:RelationshipGraph ;
    pl:producesArtifact pl:IntegrityReport .

pl:RuntimeVerification
    a pl:Stage ;
    pl:consumesArtifact pl:IntegrityReport ;
    pl:producesArtifact pl:RuntimeReport .

###############################################################
# ARTIFACTS
###############################################################

pl:ArtifactInventory
    a pl:Artifact ;
    pl:implementsContract pl:ArtifactContract .

pl:ArtifactRecords
    a pl:Artifact ;
    pl:implementsContract pl:ArtifactRecordContract .

pl:RelationshipGraph
    a pl:Artifact ;
    pl:implementsContract pl:RelationshipContract .

pl:IntegrityReport
    a pl:Artifact ;
    pl:implementsContract pl:IntegrityContract .

pl:RuntimeReport
    a pl:Artifact ;
    pl:implementsContract pl:RuntimeContract .

###############################################################
# CONTRACTS
###############################################################

pl:ArtifactContract
    a pl:Contract .

pl:ArtifactRecordContract
    a pl:Contract .

pl:RelationshipContract
    a pl:Contract .

pl:IntegrityContract
    a pl:Contract .

pl:RuntimeContract
    a pl:Contract .

