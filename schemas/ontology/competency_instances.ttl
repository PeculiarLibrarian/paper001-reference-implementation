@prefix pl: <https://peculiarlibrarian.org/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

#################################################################
# COMPETENCY INSTANCES (GROUNDING LAYER)
#################################################################

pl:CompetencyInstance
    a rdf:Class ;
    rdfs:label "Competency Instance" .

pl:instantiatesCompetency
    a rdf:Property ;
    rdfs:domain pl:Person ;
    rdfs:range pl:CompetencyInstance .

pl:instanceOfCompetency
    a rdf:Property ;
    rdfs:domain pl:CompetencyInstance ;
    rdfs:range pl:Competency .
