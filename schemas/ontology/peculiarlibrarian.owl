@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

@prefix pl: <https://peculiarlibrarian.org/ontology/> .
@prefix pltax: <https://peculiarlibrarian.org/taxonomy/> .

pl:PeculiarLibrarianOntology
    a owl:Ontology ;
    rdfs:label "PeculiarLibrarian Ontology" ;
    rdfs:comment "Ontology supporting autonomous competency discovery, evidence management, and opportunity matching." .

#################################################################
# CORE CLASSES
#################################################################

pl:Person
    a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "An individual represented within the PeculiarLibrarian ecosystem." .

pl:Competency
    a owl:Class ;
    rdfs:label "Competency" ;
    rdfs:comment "A demonstrable capability linked to one or more taxonomy concepts." .

pl:Technology
    a owl:Class ;
    rdfs:label "Technology" ;
    rdfs:comment "A technology, standard, platform, framework, or protocol." .

pl:Project
    a owl:Class ;
    rdfs:label "Project" ;
    rdfs:comment "A project demonstrating competencies and technology usage." .

pl:Evidence
    a owl:Class ;
    rdfs:label "Evidence" ;
    rdfs:comment "An artifact supporting competency claims." .

pl:Publication
    a owl:Class ;
    rdfs:label "Publication" ;
    rdfs:comment "A published work demonstrating knowledge or expertise." .

pl:Repository
    a owl:Class ;
    rdfs:label "Repository" ;
    rdfs:comment "A source-code or knowledge repository." .

pl:Organization
    a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An organization, company, laboratory, institution, or community." .

pl:Opportunity
    a owl:Class ;
    rdfs:label "Opportunity" ;
    rdfs:comment "A role, contract, collaboration, grant, fellowship, or employment opportunity." .

pl:Application
    a owl:Class ;
    rdfs:label "Application" ;
    rdfs:comment "An application submitted in pursuit of an opportunity." .

pl:Agent
    a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "An autonomous or semi-autonomous software agent." .

#################################################################
# OBJECT PROPERTIES
#################################################################

pl:hasCompetency
    a owl:ObjectProperty ;
    rdfs:domain pl:Person ;
    rdfs:range pl:Competency ;
    rdfs:label "has competency" .

pl:demonstratesCompetency
    a owl:ObjectProperty ;
    rdfs:domain pl:Project ;
    rdfs:range pl:Competency ;
    rdfs:label "demonstrates competency" .

pl:supportsCompetency
    a owl:ObjectProperty ;
    rdfs:domain pl:Evidence ;
    rdfs:range pl:Competency ;
    rdfs:label "supports competency" .

pl:requiresCompetency
    a owl:ObjectProperty ;
    rdfs:domain pl:Opportunity ;
    rdfs:range pl:Competency ;
    rdfs:label "requires competency" .

pl:usesTechnology
    a owl:ObjectProperty ;
    rdfs:domain pl:Project ;
    rdfs:range pl:Technology ;
    rdfs:label "uses technology" .

pl:publishedBy
    a owl:ObjectProperty ;
    rdfs:domain pl:Publication ;
    rdfs:range pl:Person ;
    rdfs:label "published by" .

pl:maintainsRepository
    a owl:ObjectProperty ;
    rdfs:domain pl:Person ;
    rdfs:range pl:Repository ;
    rdfs:label "maintains repository" .

pl:belongsToOrganization
    a owl:ObjectProperty ;
    rdfs:domain pl:Person ;
    rdfs:range pl:Organization ;
    rdfs:label "belongs to organization" .

pl:targetsOpportunity
    a owl:ObjectProperty ;
    rdfs:domain pl:Application ;
    rdfs:range pl:Opportunity ;
    rdfs:label "targets opportunity" .

pl:submittedBy
    a owl:ObjectProperty ;
    rdfs:domain pl:Application ;
    rdfs:range pl:Person ;
    rdfs:label "submitted by" .

pl:managedByAgent
    a owl:ObjectProperty ;
    rdfs:domain pl:Application ;
    rdfs:range pl:Agent ;
    rdfs:label "managed by agent" .

pl:discoversOpportunity
    a owl:ObjectProperty ;
    rdfs:domain pl:Agent ;
    rdfs:range pl:Opportunity ;
    rdfs:label "discovers opportunity" .

#################################################################
# TAXONOMY LINKAGE
#################################################################

pl:referencesTaxonomyConcept
    a owl:ObjectProperty ;
    rdfs:domain pl:Competency ;
    rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
    rdfs:label "references taxonomy concept" ;
    rdfs:comment "Links an instantiated competency to a competency concept defined in the SKOS taxonomy." .

#################################################################
# PROFILE CLASSES
#################################################################

pl:ProfessionalProfile
    a owl:Class ;
    rdfs:label "Professional Profile" ;
    rdfs:comment "A managed professional representation used for opportunity discovery and competency management." .

pl:DigitalCV
    a owl:Class ;
    rdfs:label "Digital CV" ;
    rdfs:comment "Machine-readable curriculum vitae maintained by autonomous agents." .

#################################################################
# PROFILE PROPERTIES
#################################################################

pl:hasProfile
    a owl:ObjectProperty ;
    rdfs:domain pl:Person ;
    rdfs:range pl:ProfessionalProfile .

pl:hasDigitalCV
    a owl:ObjectProperty ;
    rdfs:domain pl:ProfessionalProfile ;
    rdfs:range pl:DigitalCV .

#################################################################
# OPPORTUNITY TYPES
#################################################################

pl:JobOpportunity
    a owl:Class ;
    rdfs:subClassOf pl:Opportunity ;
    rdfs:label "Job Opportunity" .

pl:ContractOpportunity
    a owl:Class ;
    rdfs:subClassOf pl:Opportunity ;
    rdfs:label "Contract Opportunity" .

pl:FellowshipOpportunity
    a owl:Class ;
    rdfs:subClassOf pl:Opportunity ;
    rdfs:label "Fellowship Opportunity" .

pl:ResearchCollaboration
    a owl:Class ;
    rdfs:subClassOf pl:Opportunity ;
    rdfs:label "Research Collaboration" .

#################################################################
# EVIDENCE RELATIONSHIPS
#################################################################

pl:derivedFromRepository
    a owl:ObjectProperty ;
    rdfs:domain pl:Evidence ;
    rdfs:range pl:Repository ;
    rdfs:label "derived from repository" .

pl:documentsProject
    a owl:ObjectProperty ;
    rdfs:domain pl:Repository ;
    rdfs:range pl:Project ;
    rdfs:label "documents project" .

#################################################################
# EXECUTION MODEL
#################################################################

pl:Pipeline
    a owl:Class ;
    rdfs:label "Pipeline" ;
    rdfs:comment "A deterministic sequence of executable semantic stages." .

pl:Stage
    a owl:Class ;
    rdfs:label "Stage" ;
    rdfs:comment "An executable semantic unit within a pipeline." .

pl:Artifact
    a owl:Class ;
    rdfs:label "Artifact" ;
    rdfs:comment "A knowledge artifact consumed or produced during execution." .

pl:Execution
    a owl:Class ;
    rdfs:label "Execution" ;
    rdfs:comment "A realized execution of a pipeline." .

pl:Contract
    a owl:Class ;
    rdfs:label "Contract" ;
    rdfs:comment "A semantic contract governing artifacts, stages, or execution." .

#################################################################
# EXECUTION RELATIONSHIPS
#################################################################

pl:hasStage
    a owl:ObjectProperty ;
    rdfs:domain pl:Pipeline ;
    rdfs:range pl:Stage ;
    rdfs:label "has stage" .

pl:dependsOnStage
    a owl:ObjectProperty ;
    rdfs:domain pl:Stage ;
    rdfs:range pl:Stage ;
    rdfs:label "depends on stage" .

pl:producesArtifact
    a owl:ObjectProperty ;
    rdfs:domain pl:Stage ;
    rdfs:range pl:Artifact ;
    rdfs:label "produces artifact" .

pl:consumesArtifact
    a owl:ObjectProperty ;
    rdfs:domain pl:Stage ;
    rdfs:range pl:Artifact ;
    rdfs:label "consumes artifact" .

pl:implementsContract
    a owl:ObjectProperty ;
    rdfs:domain pl:Artifact ;
    rdfs:range pl:Contract ;
    rdfs:label "implements contract" .

pl:verifiedByContract
    a owl:ObjectProperty ;
    rdfs:domain pl:Artifact ;
    rdfs:range pl:Contract ;
    rdfs:label "verified by contract" .

pl:realizesPipeline
    a owl:ObjectProperty ;
    rdfs:domain pl:Execution ;
    rdfs:range pl:Pipeline ;
    rdfs:label "realizes pipeline" .

pl:executesStage
    a owl:ObjectProperty ;
    rdfs:domain pl:Execution ;
    rdfs:range pl:Stage ;
    rdfs:label "executes stage" .

