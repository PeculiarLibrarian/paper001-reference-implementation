@prefix pl: <https://peculiarlibrarian.org/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# CAPABILITY ONTOLOGY
#################################################################

pl:Capability
    rdf:type rdfs:Class .

pl:CapabilityProfile
    rdf:type rdfs:Class .

pl:CapabilityLevel
    rdf:type rdfs:Class .

#################################################################
# OBJECT PROPERTIES
#################################################################

pl:hasCapability
    rdf:type rdf:Property .

pl:hasCapabilityProfile
    rdf:type rdf:Property .

pl:hasCapabilityLevel
    rdf:type rdf:Property .

pl:producesCapability
    rdf:type rdf:Property .

pl:requiresCapability
    rdf:type rdf:Property .

#################################################################
# DATATYPE PROPERTIES
#################################################################

pl:capabilityName
    rdf:type rdf:Property .

pl:capabilityDescription
    rdf:type rdf:Property .

#################################################################
# INITIAL SEED CAPABILITIES (aligned to your existing system)
#################################################################

pl:KnowledgeGraphConstructionCapability
    rdf:type pl:Capability .

pl:OntologyAlignmentCapability
    rdf:type pl:Capability .

pl:SemanticQueryCapability
    rdf:type pl:Capability .

pl:GraphReasoningCapability
    rdf:type pl:Capability .

pl:AgentOrchestrationCapability
    rdf:type pl:Capability .
