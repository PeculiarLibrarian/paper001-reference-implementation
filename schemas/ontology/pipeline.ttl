@prefix pl:   <https://peculiarlibrarian.org/ontology/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

############################################################
# Pipeline
############################################################

pl:SemanticPipeline
    rdf:type pl:Pipeline ;
    rdfs:label "Semantic Execution Pipeline" .

############################################################
# Passes
############################################################

pl:BootstrapPass
    rdf:type pl:PipelinePass ;
    pl:order 1 .

pl:MatchingPass
    rdf:type pl:PipelinePass ;
    pl:order 2 .

pl:GapAnalysisPass
    rdf:type pl:PipelinePass ;
    pl:order 3 .

pl:RecommendationPass
    rdf:type pl:PipelinePass ;
    pl:order 4 .

pl:CoveragePass
    rdf:type pl:PipelinePass ;
    pl:order 5 .

pl:ClosurePass
    rdf:type pl:PipelinePass ;
    pl:order 6 .

pl:ReportPass
    rdf:type pl:PipelinePass ;
    pl:order 7 .

############################################################
# Pipeline membership
############################################################

pl:SemanticPipeline pl:hasPass pl:BootstrapPass .
pl:SemanticPipeline pl:hasPass pl:MatchingPass .
pl:SemanticPipeline pl:hasPass pl:GapAnalysisPass .
pl:SemanticPipeline pl:hasPass pl:RecommendationPass .
pl:SemanticPipeline pl:hasPass pl:CoveragePass .
pl:SemanticPipeline pl:hasPass pl:ClosurePass .
pl:SemanticPipeline pl:hasPass pl:ReportPass .
