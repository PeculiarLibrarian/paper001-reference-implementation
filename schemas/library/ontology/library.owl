@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix lib: <https://peculiarlibrarian.org/library/> .

####################################################
# Library Ontology
####################################################

lib:Library
    a owl:Class ;
    rdfs:label "Library" .

lib:Collection
    a owl:Class ;
    rdfs:label "Collection" .

lib:SemanticArtifact
    a owl:Class ;
    rdfs:label "Semantic Artifact" .

lib:Ontology
    a owl:Class ;
    rdfs:subClassOf lib:SemanticArtifact .

lib:Taxonomy
    a owl:Class ;
    rdfs:subClassOf lib:SemanticArtifact .

lib:Shape
    a owl:Class ;
    rdfs:subClassOf lib:SemanticArtifact .

lib:Query
    a owl:Class ;
    rdfs:subClassOf lib:SemanticArtifact .

lib:Knowledge
    a owl:Class ;
    rdfs:subClassOf lib:SemanticArtifact .

####################################################
# Relationships
####################################################

lib:containsCollection
    a owl:ObjectProperty ;
    rdfs:domain lib:Library ;
    rdfs:range lib:Collection .

lib:containsArtifact
    a owl:ObjectProperty ;
    rdfs:domain lib:Collection ;
    rdfs:range lib:SemanticArtifact .

lib:dependsOn
    a owl:ObjectProperty ;
    rdfs:domain lib:SemanticArtifact ;
    rdfs:range lib:SemanticArtifact .

