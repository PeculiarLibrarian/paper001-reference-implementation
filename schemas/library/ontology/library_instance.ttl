@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix lib: <https://peculiarlibrarian.org/library/> .
@prefix fin: <https://peculiarlibrarian.org/finance/> .

####################################################
# Peculiar Librarian
####################################################

lib:PeculiarLibrarian
    rdf:type lib:Library ;

    rdfs:label "Peculiar Librarian" ;

    lib:containsCollection fin:FinanceCollection .
