@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix fin: <https://peculiarlibrarian.org/finance/> .

####################################################
# Observation Status
####################################################

fin:ObservationStatus
    rdf:type rdfs:Class .

####################################################
# Status Vocabulary
####################################################

fin:Verified
    rdf:type fin:ObservationStatus ;
    rdfs:label "Verified" .

fin:NotExplicitlyReported
    rdf:type fin:ObservationStatus ;
    rdfs:label "Not Explicitly Reported" .

fin:PendingExtraction
    rdf:type fin:ObservationStatus ;
    rdfs:label "Pending Extraction" .

fin:Estimated
    rdf:type fin:ObservationStatus ;
    rdfs:label "Estimated" .

fin:Superseded
    rdf:type fin:ObservationStatus ;
    rdfs:label "Superseded" .

