@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix fin: <https://peculiarlibrarian.org/finance/> .

####################################################
# Exchange
####################################################

fin:NSE
    rdf:type fin:Exchange ;
    rdfs:label "Nairobi Securities Exchange" .

####################################################
# Sector
####################################################

fin:Telecommunications
    rdf:type fin:Sector ;
    rdfs:label "Telecommunications" .

####################################################
# Country
####################################################

fin:Kenya
    rdf:type fin:Country ;
    rdfs:label "Kenya" .

####################################################
# Currency
####################################################

fin:KES
    rdf:type fin:Currency ;
    rdfs:label "Kenyan Shilling" .

