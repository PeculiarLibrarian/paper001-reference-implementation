@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix fin: <https://peculiarlibrarian.org/finance/> .

####################################################
# Scale
####################################################

fin:Scale
    rdf:type rdfs:Class .

####################################################
# Financial Scales
####################################################

fin:Unit
    rdf:type fin:Scale ;
    rdfs:label "Unit" .

fin:Thousand
    rdf:type fin:Scale ;
    rdfs:label "Thousand" .

fin:Million
    rdf:type fin:Scale ;
    rdfs:label "Million" .

fin:Billion
    rdf:type fin:Scale ;
    rdfs:label "Billion" .

fin:Percentage
    rdf:type fin:Scale ;
    rdfs:label "Percentage" .

