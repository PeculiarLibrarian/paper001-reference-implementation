fin:SafaricomDividendFY2021
    rdf:type fin:Observation ;
    fin:observesCompany fin:SafaricomPLC ;
    fin:hasReportingScope fin:GroupScope ;
    fin:hasMetric fin:DividendPerShare ;
    fin:hasReportingPeriod fin:FY2021 ;
    fin:value "1.37"^^xsd:decimal ;
    fin:hasCurrency fin:KenyanShilling ;
    fin:hasScale fin:NoScale ;
    fin:hasMeasurementUnit fin:PerShare ;
    fin:derivedFromEvidence fin:SafaricomAnnualReport2021 ;
    fin:hasCitation fin:SafaricomDividendCitationFY2021 ;
    fin:hasObservationStatus fin:Verified ;
    fin:hasObservationConfidence fin:HighConfidence .

