@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix fin: <https://peculiarlibrarian.org/finance/> .

####################################################
# Reporting Scope
####################################################

fin:ReportingScope
    rdf:type rdfs:Class .

####################################################
# Scope Vocabulary
####################################################

fin:GroupScope
    rdf:type fin:ReportingScope ;
    rdfs:label "Group" .

fin:KenyaScope
    rdf:type fin:ReportingScope ;
    rdfs:label "Safaricom Kenya" .

fin:EthiopiaScope
    rdf:type fin:ReportingScope ;
    rdfs:label "Safaricom Ethiopia" .

fin:ParentCompanyScope
    rdf:type fin:ReportingScope ;
    rdfs:label "Parent Company" .

