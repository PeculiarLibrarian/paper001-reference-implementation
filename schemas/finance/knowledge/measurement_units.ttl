@prefix fin:  <https://peculiarlibrarian.org/finance/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

####################################################
# Measurement Scale
####################################################

fin:MeasurementScale
    a rdfs:Class ;
    rdfs:label "Measurement Scale" .

fin:NoScale
    rdf:type fin:MeasurementScale ;
    rdfs:label "No Scale" .

fin:Thousand
    rdf:type fin:MeasurementScale ;
    rdfs:label "Thousand" .

fin:Million
    rdf:type fin:MeasurementScale ;
    rdfs:label "Million" .

fin:Billion
    rdf:type fin:MeasurementScale ;
    rdfs:label "Billion" .

fin:Trillion
    rdf:type fin:MeasurementScale ;
    rdfs:label "Trillion" .
