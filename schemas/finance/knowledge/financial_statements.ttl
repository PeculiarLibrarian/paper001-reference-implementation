@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix fin: <https://peculiarlibrarian.org/finance/> .

####################################################
# Statement Types
####################################################

fin:IncomeStatement
    rdf:type fin:FinancialStatement ;
    rdfs:label "Income Statement" .

fin:BalanceSheet
    rdf:type fin:FinancialStatement ;
    rdfs:label "Balance Sheet" .

fin:CashFlowStatement
    rdf:type fin:FinancialStatement ;
    rdfs:label "Cash Flow Statement" .

fin:StatementOfEquity
    rdf:type fin:FinancialStatement ;
    rdfs:label "Statement of Changes in Equity" .

