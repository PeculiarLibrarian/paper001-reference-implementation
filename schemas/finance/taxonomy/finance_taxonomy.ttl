@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix finance: <https://peculiarlibrarian.org/finance/taxonomy#> .

#################################################################
# Finance Concept Scheme
#################################################################

finance:FinanceTaxonomy
    a skos:ConceptScheme ;
    skos:prefLabel "Finance Taxonomy"@en ;
    skos:definition "Controlled vocabulary for financial knowledge."@en .

#################################################################
# Company
#################################################################

finance:Company
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Company"@en .

#################################################################
# Financial Statements
#################################################################

finance:IncomeStatement
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Income Statement"@en .

finance:BalanceSheet
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Balance Sheet"@en .

finance:CashFlowStatement
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Cash Flow Statement"@en .

#################################################################
# Metrics
#################################################################

finance:Revenue
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Revenue"@en .

finance:OperatingProfit
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Operating Profit"@en .

finance:NetProfit
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Net Profit"@en .

finance:EPS
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Earnings Per Share"@en .

finance:Dividend
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Dividend"@en .

finance:TotalAssets
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Total Assets"@en .

finance:TotalLiabilities
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Total Liabilities"@en .

finance:Equity
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Equity"@en .

finance:OperatingCashFlow
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Operating Cash Flow"@en .

finance:FreeCashFlow
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Free Cash Flow"@en .

#################################################################
# Reporting Periods
#################################################################

finance:FY2025
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "FY2025"@en .

#################################################################
# Units
#################################################################

finance:KES
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Kenyan Shilling"@en .

finance:Millions
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Millions"@en .

finance:Billions
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Billions"@en .

finance:Percent
    a skos:Concept ;
    skos:inScheme finance:FinanceTaxonomy ;
    skos:prefLabel "Percent"@en .
