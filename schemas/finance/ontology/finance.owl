@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix fin: <https://peculiarlibrarian.org/finance/> .

fin:FinanceOntology
    a owl:Ontology ;
    rdfs:label "Finance Collection Ontology" .

####################################################
# Core Concepts
####################################################

fin:Market
    a owl:Class .

fin:Exchange
    a owl:Class .

fin:Security
    a owl:Class .

fin:Equity
    a owl:Class ;
    rdfs:subClassOf fin:Security .

fin:Portfolio
    a owl:Class .

fin:Position
    a owl:Class .

fin:Order
    a owl:Class .

fin:Trade
    a owl:Class .

fin:Cash
    a owl:Class .

fin:Strategy
    a owl:Class .

fin:InvestmentPolicy
    a owl:Class .

fin:Risk
    a owl:Class .

fin:Opportunity
    a owl:Class .

fin:Evidence
    a owl:Class .

fin:Recommendation
    a owl:Class .

fin:Dividend
    a owl:Class .

fin:CorporateAction
    a owl:Class .

fin:MarketObservation
    a owl:Class .

####################################################
# Core Relationships
####################################################

fin:ownsPosition
    a owl:ObjectProperty ;
    rdfs:domain fin:Portfolio ;
    rdfs:range fin:Position .

fin:referencesSecurity
    a owl:ObjectProperty ;
    rdfs:domain fin:Position ;
    rdfs:range fin:Security .

fin:listedOn
    a owl:ObjectProperty ;
    rdfs:domain fin:Security ;
    rdfs:range fin:Exchange .

fin:belongsToMarket
    a owl:ObjectProperty ;
    rdfs:domain fin:Security ;
    rdfs:range fin:Market .

fin:targetsSecurity
    a owl:ObjectProperty ;
    rdfs:domain fin:Order ;
    rdfs:range fin:Security .

fin:producesTrade
    a owl:ObjectProperty ;
    rdfs:domain fin:Order ;
    rdfs:range fin:Trade .

fin:supportsRecommendation
    a owl:ObjectProperty ;
    rdfs:domain fin:Evidence ;
    rdfs:range fin:Recommendation .

fin:identifiesOpportunity
    a owl:ObjectProperty ;
    rdfs:domain fin:Recommendation ;
    rdfs:range fin:Opportunity .


####################################################
# Company
####################################################

fin:Company
    a owl:Class .

####################################################
# Relationships
####################################################

fin:issuesSecurity
    a owl:ObjectProperty ;
    rdfs:domain fin:Company ;
    rdfs:range fin:Security .

fin:listedOnExchange
    a owl:ObjectProperty ;
    rdfs:domain fin:Company ;
    rdfs:range fin:Exchange .

fin:operatesInMarket
    a owl:ObjectProperty ;
    rdfs:domain fin:Company ;
    rdfs:range fin:Market .


####################################################
# Authority Classes
####################################################

fin:Sector
    a owl:Class .

fin:Country
    a owl:Class .

fin:Currency
    a owl:Class .

fin:Exchange
    a owl:Class .

####################################################
# Datatype Properties
####################################################

fin:ticker
    a owl:DatatypeProperty ;
    rdfs:domain fin:Company .

fin:status
    a owl:DatatypeProperty ;
    rdfs:domain fin:Company .

####################################################
# Object Properties
####################################################

fin:belongsToSector
    a owl:ObjectProperty ;
    rdfs:domain fin:Company ;
    rdfs:range fin:Sector .

fin:domiciledIn
    a owl:ObjectProperty ;
    rdfs:domain fin:Company ;
    rdfs:range fin:Country .

fin:tradesInCurrency
    a owl:ObjectProperty ;
    rdfs:domain fin:Company ;
    rdfs:range fin:Currency .

fin:listedOn
    a owl:ObjectProperty ;
    rdfs:domain fin:Company ;
    rdfs:range fin:Exchange .


####################################################
# Inverse Properties
####################################################

fin:issuedBy
    a owl:ObjectProperty ;
    owl:inverseOf fin:issuesSecurity ;
    rdfs:domain fin:Security ;
    rdfs:range fin:Company .

fin:listsSecurity
    a owl:ObjectProperty ;
    owl:inverseOf fin:listedOn ;
    rdfs:domain fin:Exchange ;
    rdfs:range fin:Security .

fin:containsExchange
    a owl:ObjectProperty ;
    owl:inverseOf fin:operatesWithin ;
    rdfs:domain fin:Market ;
    rdfs:range fin:Exchange .

fin:ownedByPortfolio
    a owl:ObjectProperty ;
    owl:inverseOf fin:ownsPosition ;
    rdfs:domain fin:Position ;
    rdfs:range fin:Portfolio .

fin:generatedByOrder
    a owl:ObjectProperty ;
    owl:inverseOf fin:producesTrade ;
    rdfs:domain fin:Trade ;
    rdfs:range fin:Order .

fin:createdByTrade
    a owl:ObjectProperty ;
    owl:inverseOf fin:createsPosition ;
    rdfs:domain fin:Position ;
    rdfs:range fin:Trade .

fin:supportedByEvidence
    a owl:ObjectProperty ;
    owl:inverseOf fin:supportsRecommendation ;
    rdfs:domain fin:Recommendation ;
    rdfs:range fin:Evidence .

fin:identifiedByRecommendation
    a owl:ObjectProperty ;
    owl:inverseOf fin:identifiesOpportunity ;
    rdfs:domain fin:Opportunity ;
    rdfs:range fin:Recommendation .


####################################################
# Evidence
####################################################

fin:Evidence
    a owl:Class .

fin:AnnualReport
    a owl:Class ;
    rdfs:subClassOf fin:Evidence .

fin:FinancialStatement
    a owl:Class ;
    rdfs:subClassOf fin:Evidence .

fin:DividendDeclaration
    a owl:Class ;
    rdfs:subClassOf fin:Evidence .

fin:CorporateAction
    a owl:Class ;
    rdfs:subClassOf fin:Evidence .

####################################################
# Evidence Relationships
####################################################

fin:describesCompany
    a owl:ObjectProperty ;
    rdfs:domain fin:Evidence ;
    rdfs:range fin:Company .

fin:supportsKnowledge
    a owl:ObjectProperty ;
    rdfs:domain fin:Evidence ;
    rdfs:range fin:Knowledge .

fin:hasSource
    a owl:DatatypeProperty ;
    rdfs:domain fin:Evidence .

fin:publicationDate
    a owl:DatatypeProperty ;
    rdfs:domain fin:Evidence .


####################################################
# Observation
####################################################

fin:Observation
    a owl:Class .

####################################################
# Observation Relationships
####################################################

fin:observesCompany
    a owl:ObjectProperty ;
    rdfs:domain fin:Observation ;
    rdfs:range fin:Company .

fin:derivedFromEvidence
    a owl:ObjectProperty ;
    rdfs:domain fin:Observation ;
    rdfs:range fin:Evidence .

####################################################
# Observation Values
####################################################

fin:metric
    a owl:DatatypeProperty ;
    rdfs:domain fin:Observation .

fin:value
    a owl:DatatypeProperty ;
    rdfs:domain fin:Observation .

fin:observationDate
    a owl:DatatypeProperty ;
    rdfs:domain fin:Observation .

fin:unit
    a owl:DatatypeProperty ;
    rdfs:domain fin:Observation .


####################################################
# Observation Metric
####################################################

fin:hasMetric
    a owl:ObjectProperty ;
    rdfs:domain fin:Observation ;
    rdfs:range fin:FinancialMetric .


####################################################
# Financial Statements
####################################################

fin:FinancialStatement
    a owl:Class .

####################################################
# Statement Relationships
####################################################

fin:belongsToStatement
    a owl:ObjectProperty ;
    rdfs:domain fin:FinancialMetric ;
    rdfs:range fin:FinancialStatement .


####################################################
# Reporting Period
####################################################

fin:ReportingPeriod
    a owl:Class .

####################################################
# Observation Period
####################################################

fin:hasReportingPeriod
    a owl:ObjectProperty ;
    rdfs:domain fin:Observation ;
    rdfs:range fin:ReportingPeriod .


####################################################
# Citation
####################################################

fin:Citation
    a owl:Class .

####################################################
# Citation Relationships
####################################################

fin:hasCitation
    a owl:ObjectProperty ;
    rdfs:domain fin:Observation ;
    rdfs:range fin:Citation .

####################################################
# Citation Metadata
####################################################

fin:pageNumber
    a owl:DatatypeProperty ;
    rdfs:domain fin:Citation .

fin:section
    a owl:DatatypeProperty ;
    rdfs:domain fin:Citation .

fin:noteReference
    a owl:DatatypeProperty ;
    rdfs:domain fin:Citation .


####################################################
# Measurement Units
####################################################

fin:Scale
    a owl:Class .

####################################################
# Observation Units
####################################################

fin:hasCurrency
    a owl:ObjectProperty ;
    rdfs:domain fin:Observation ;
    rdfs:range fin:Scale .

fin:hasScale
    a owl:ObjectProperty ;
    rdfs:domain fin:Observation ;
    rdfs:range fin:Scale .


####################################################
# Observation Status
####################################################

fin:ObservationStatus
    a owl:Class .

fin:hasObservationStatus
    a owl:ObjectProperty ;
    rdfs:domain fin:Observation ;
    rdfs:range fin:ObservationStatus .


####################################################
# Observation Confidence
####################################################

fin:ObservationConfidence
    a owl:Class .

fin:hasObservationConfidence
    a owl:ObjectProperty ;
    rdfs:domain fin:Observation ;
    rdfs:range fin:ObservationConfidence .


####################################################
# Reporting Scope
####################################################

fin:ReportingScope
    a owl:Class .

fin:hasReportingScope
    a owl:ObjectProperty ;
    rdfs:domain fin:Observation ;
    rdfs:range fin:ReportingScope .

